# Database Configuration
DB_NAME=codementor
DB_USER=postgres
DB_PASSWORD=your-secure-password-here

SERVER_PORT=port
SERVER_CONTEXT_PATH=path

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400000

# Frontend Configuration
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com/api/v1

# Code Editor Configuration
CODE_EDITOR_URL=https://your-domain.com:3000
CODE_EDITOR_WS_URL=wss://your-domain.com:8081

# Judge0 API Configuration (for code execution)
JUDGE0_API=https://judge0-ce.p.rapidapi.com
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your-rapidapi-key-here

# Chatbot Configuration
CHATBOT_SECRET_KEY=your-chatbot-secret-key-change-in-production
DEFAULT_AI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MAX_MESSAGE_LENGTH=4000
MAX_HISTORY_LENGTH=50
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
LOG_LEVEL=INFO
