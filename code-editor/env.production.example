# Production Environment Configuration
NODE_ENV=production
PORT=3000
WS_PORT=8081

# CORS Configuration - Update with your actual domains
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-backend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Execution Limits
MAX_CONCURRENT_EXECUTIONS=5
MAX_QUEUE_SIZE=10
CODE_SIZE_LIMIT=50000
EXECUTION_TIMEOUT=15000
CPU_TIME_LIMIT=5
MEMORY_LIMIT=512000

# Monitoring
ENABLE_LOGGING=true
LOG_LEVEL=info

# Judge0 API Configuration (if using Judge0)
JUDGE0_API=https://judge0-ce.p.rapidapi.com
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
RAPIDAPI_KEY=your-rapidapi-key-here 